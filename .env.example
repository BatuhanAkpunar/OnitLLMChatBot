# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by background jobs (summarization) and admin actions that bypass RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- OpenRouter (LLM gateway) ----
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Default chat model (admin-configurable later). Browse models at https://openrouter.ai/models
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# Cheaper model used for the "thinking bubble" and background summaries to control cost.
OPENROUTER_SUMMARY_MODEL=openai/gpt-4o-mini

# ---- App ----
# Used to build OAuth redirect URLs. Set to the production URL on Vercel (https://onit-ai.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The single admin account that can access /admin.
ADMIN_EMAIL=batuhan.akpunar@gmail.com
