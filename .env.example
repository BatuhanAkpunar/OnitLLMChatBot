# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used by background jobs (summarization) and admin actions that bypass RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Gemini (Google AI Studio) ----
# OPTIONAL. The hosted app is bring-your-own-key: each user pastes their own key
# in Settings (stored in an httpOnly cookie), so production leaves this UNSET.
# Set it only for local dev or a self-hosted single-key deploy.
GEMINI_API_KEY=
# Default chat model. Browse models at https://ai.google.dev/gemini-api/docs/models
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
# Cheaper non-reasoning model used for routing, titles, and background summaries.
GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite
# Used when the primary model errors or times out mid-request.
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ---- App ----
# Used to build OAuth redirect URLs. Set to the production URL on Vercel (https://onit-ai.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The single admin account that can access /admin.
ADMIN_EMAIL=you@example.com
